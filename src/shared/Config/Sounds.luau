--!strict
-- Звуки игры. Источник: официальная бесплатная библиотека Roblox (Pro Sound Effects),
-- все 45 файлов проверены на загрузку. Чтобы заменить звук, поменяй id здесь.
-- Каждый id — «rbxassetid://число». Разнообразие даёт высота тона (speed) и слои.

local function a(id: number): string
	return "rbxassetid://" .. id
end

export type Layer = { id: string, volume: number, speed: number? }

