-- shape — форма воксельной модели (TreeBuilder), цвета — палитра вокселей.
-- Подробности баланса: «Баланс и прогрессия.md».

export type Tree = {
	id: string,
	name: string,
	rarity: string,
	n: number,
	shape: string,
	leaf: Color3,
	trunk: Color3,
	fruit: Color3?,
	glow: boolean?,
}

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

