--!strict
-- 20 видов оружия для подземелья. Выпадают из волн и босса (не за Robux), хранятся в профиле,
-- надеваются в «Profile → Weapons». Первое оружие выдаётся сразу.
-- damage — множитель к базовому урону игрока, cooldown — секунд между ударами, range — studs.
-- kind определяет форму модели и звук; anim = true у 12 из 20: у них свечение, частицы,
-- след за клинком, вращающиеся элементы и дуга удара в цвет оружия (60% набора).
-- value — монеты за дубликат (дубликаты продаются автоматически).

export type Weapon = {
	id: string,
	name: string,
	kind: string, -- sword, axe, dagger, staff, spear, hammer, scythe, katana
	tier: number, -- 1..5, чем выше, тем реже
	damage: number,
	cooldown: number,
	range: number,
	scale: number, -- размер модели
	value: number,
	anim: boolean,
	blade: Color3,
	edge: Color3, -- кромка/свечение
	hilt: Color3,
	accent: Color3,
	swing: string, -- ключ звука взмаха (Config.Sounds.swing)
	hit: string, -- ключ звука попадания (Config.Sounds.hit)
	toolanim: string, -- Slash или Lunge (стандартная анимация руки)
	particles: string?, -- embers, frost, sparks, void, sun, stars, petals
}

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

